<%- include('../partials/header', { title }) %>
<div class="admin-content">
  <div class="admin-heading"><div><h1>Soucha Admin</h1><p>Quản lý <%= config.plural.toLowerCase() %> · dữ liệu được tải lại từ database</p></div><a class="button primary" href="/admin/<%= resource %>/new">+ Thêm <%= config.singular.toLowerCase() %></a></div>
  <nav class="admin-tabs" aria-label="Khu vực quản lý"><a class="<%= resource === 'dishes' ? 'active' : '' %>" href="/admin/dishes">Quản lý món</a><a class="<%= resource === 'chefs' ? 'active' : '' %>" href="/admin/chefs">Đầu bếp</a><a class="<%= resource === 'ingredients' ? 'active' : '' %>" href="/admin/ingredients">Nguyên liệu</a></nav>
  <p class="admin-count"><%= rows.length %> bản ghi</p>
  <% if (rows.length) { %><div class="admin-list"><% rows.forEach((row) => { %><article class="admin-row"><div class="admin-thumb"><% if (resource === 'dishes' && row.image) { %><img src="<%= row.image %>" alt=""><% } else { %><span aria-hidden="true"><%= resource === 'dishes' ? '🍵' : resource === 'chefs' ? '👨‍🍳' : '🌿' %></span><% } %></div><div class="admin-row-copy"><h2><% if (resource === 'dishes') { %><a href="/admin/dishes/<%= row.id %>"><%= row.name %></a><% } else if (resource === 'chefs') { %><a href="/admin/chefs/<%= row.id %>"><%= row.name %></a><% } else { %><%= row.name %><% } %></h2><p><% if (resource === 'dishes') { %><%= categoryLabel(row.category) %> · <%= formatVND(row.price) %> · <%= row.available ? 'Đang bán' : 'Đã tắt' %><% } else if (resource === 'chefs') { %><%= row.specialty %><% } else { %>Đơn vị: <%= row.unit %> · Tồn kho: <%= row.stock %><% } %></p></div><div class="admin-actions"><% if (resource === 'dishes') { %><a class="edit" href="/admin/dishes/<%= row.id %>">Công thức</a><% } else if (resource === 'chefs') { %><a class="edit" href="/admin/chefs/<%= row.id %>">Món</a><% } %><a class="edit" href="/admin/<%= resource %>/<%= row.id %>/edit">Sửa</a><a class="delete" href="/admin/<%= resource %>/<%= row.id %>/delete">Xóa</a></div></article><% }) %></div><% } else { %><div class="empty-state"><p>Chưa có <%= config.singular.toLowerCase() %> nào.</p><a href="/admin/<%= resource %>/new">Thêm mới</a></div><% } %>
</div>
<%- include('../partials/footer') %>
