<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Student Directory — a server-rendered academic control center.">
  <meta name="theme-color" content="#050816">
  <title>Student Directory · Academic Control Center</title>
  <link rel="stylesheet" href="/styles.css">
  <script src="/app.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#student-list">Đi đến danh sách sinh viên</a>

  <div class="background-scene" aria-hidden="true">
    <div class="aurora aurora-one"></div>
    <div class="aurora aurora-two"></div>
    <div class="aurora aurora-three"></div>
    <div class="page-grid"></div>
    <div class="grain"></div>
  </div>
  <div class="cursor-light" aria-hidden="true"></div>

  <div class="page-shell">
    <header class="site-header" aria-label="Điều hướng chính">
      <a class="brand" href="/students" aria-label="Student Directory — trang chủ">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M4 9.5 12 5l8 4.5-8 4.5-8-4.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M7 12v4.2c2.8 2.1 7.2 2.1 10 0V12M20 10v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </span>
        <span>
          <strong>Academia<span class="brand-dot">.</span></strong>
          <small>Control center / 01</small>
        </span>
      </a>

      <div class="system-status" aria-label="Trạng thái hệ thống: đang hoạt động">
        <span class="status-dot" aria-hidden="true"></span>
        System online
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="page-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-glow" aria-hidden="true"></div>

        <div class="hero-copy">
          <div class="eyebrow">
            <span class="eyebrow-pulse" aria-hidden="true"></span>
            Server rendered
            <span class="eyebrow-divider" aria-hidden="true"></span>
            Express + EJS
          </div>
          <h1 id="page-title">Student<br><span>Directory</span></h1>
          <p>A beautifully server-rendered student management experience—crafted for clarity, speed and academic excellence.</p>

          <div class="hero-facts" aria-label="Thông tin kỹ thuật">
            <div class="hero-fact">
              <span>Total students</span>
              <strong><%= String(students.length).padStart(2, '0') %></strong>
            </div>
            <div class="hero-fact">
              <span>Render mode</span>
              <strong>SSR</strong>
            </div>
            <div class="hero-fact">
              <span>Storage</span>
              <strong>JSON</strong>
            </div>
          </div>
        </div>

        <div class="hero-visual" aria-label="Tổng số sinh viên: <%= students.length %>">
          <div class="orbit-stage" aria-hidden="true">
            <span class="orbit orbit-outer"></span>
            <span class="orbit orbit-middle"></span>
            <span class="orbit orbit-inner"></span>
            <span class="orbit-node node-one"></span>
            <span class="orbit-node node-two"></span>
            <span class="orbit-node node-three"></span>
            <span class="scan-line"></span>
            <div class="orbit-core">
              <span>Active records</span>
              <strong><%= String(students.length).padStart(2, '0') %></strong>
              <small>Live directory</small>
            </div>
          </div>
          <div class="visual-chip chip-top">
            <span class="chip-dot"></span>
            Data synchronized
          </div>
          <div class="visual-chip chip-bottom">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" stroke="currentColor" stroke-width="1.7"/>
              <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
            Server verified
          </div>
        </div>
      </section>

      <div class="content-grid">
        <aside class="form-panel" aria-labelledby="form-title" data-tilt-panel>
          <div class="panel-heading">
            <span class="section-kicker">Enrollment</span>
            <h2 id="form-title">Add New Student</h2>
            <p>Tạo một hồ sơ mới cho student directory.</p>
          </div>

          <% if (error) { %>
            <div class="error-message" role="alert">
              <span class="error-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 8v4.5M12 16h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </span>
              <div>
                <strong>Unable to add student</strong>
                <p><%= error %></p>
              </div>
            </div>
          <% } %>

          <form method="POST" action="/students" class="student-form">
            <div class="field-group">
              <label for="studentId">Student ID</label>
              <div class="input-wrap">
                <span class="input-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M7 8h10M7 12h6M7 16h4M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </span>
                <input type="text" id="studentId" name="studentId" placeholder="24127203" inputmode="numeric" maxlength="8" pattern="[0-9]{8}" autocomplete="off" required>
              </div>
            </div>

            <div class="field-group">
              <label for="name">Full name</label>
              <div class="input-wrap">
                <span class="input-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </span>
                <input type="text" id="name" name="name" placeholder="Nguyen Van An" maxlength="100" autocomplete="name" required>
              </div>
            </div>

            <div class="field-group">
              <label for="email">Email address</label>
              <div class="input-wrap">
                <span class="input-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="m3 6 9 7 9-7M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <input type="email" id="email" name="email" placeholder="student@university.edu" maxlength="254" autocomplete="email" required>
              </div>
            </div>

            <button type="submit" class="submit-button">
              <span class="button-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </span>
              <span>Add Student</span>
              <svg class="button-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <p class="form-note">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Validated securely on the server
            </p>
          </form>
        </aside>

        <section class="directory-panel" id="student-list" aria-labelledby="list-title">
          <div class="directory-heading">
            <div>
              <span class="section-kicker">Directory</span>
              <h2 id="list-title">Current Students</h2>
            </div>
            <span class="record-count"><%= students.length %> <%= students.length === 1 ? 'record' : 'records' %></span>
          </div>

          <% if (students.length === 0) { %>
            <div class="empty-state">
              <div class="empty-illustration" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none">
                  <path d="M8 17 24 8l16 9-16 9-16-9Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  <path d="M14 22v9c5.6 4.2 14.4 4.2 20 0v-9M40 18v11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
              <h3>No students yet</h3>
              <p>Add your first student using the enrollment form.</p>
            </div>
          <% } else { %>
            <div class="student-list">
              <% students.forEach((student, index) => { %>
                <%
                  const nameParts = student.name.trim().split(/\s+/);
                  const initials = nameParts.length > 1
                    ? `${nameParts[0][0]}${nameParts[nameParts.length - 1][0]}`
                    : nameParts[0].slice(0, 2);
                %>
                <article class="student-card" style="--index: <%= index %>; --delay: <%= 760 + index * 75 %>ms" data-tilt-card>
                  <div class="student-avatar" aria-hidden="true"><%= initials.toUpperCase() %></div>

                  <div class="student-info">
                    <h3><%= student.name %></h3>
                    <p class="student-number">
                      Student ID: <%= student.studentId || 'Chưa cập nhật' %>
                    </p>
                    <a href="mailto:<%= student.email %>">
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="m3 6 9 7 9-7M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      <%= student.email %>
                    </a>
                  </div>

                  <span class="student-id">#<%= String(student.id).padStart(3, '0') %></span>
                  <span class="card-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </article>
              <% }); %>
            </div>
          <% } %>
        </section>
      </div>
    </main>

    <footer class="site-footer">
      <span>Academic Control Center</span>
      <span class="footer-separator" aria-hidden="true"></span>
      <span>Server-rendered with Express &amp; EJS</span>
    </footer>
  </div>
</body>
</html>
