<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Academia — danh bạ sinh viên, nơi hồ sơ và những kết nối cùng bắt đầu.">
  <meta name="theme-color" content="#050816">
  <title>Danh bạ sinh viên · Academia</title>
  <link rel="stylesheet" href="/styles.css">
  <script src="/app.js" defer></script>
</head>
<body data-error-field="<%= errorField || '' %>" data-created-id="<%= createdStudentId || '' %>">
  <a class="skip-link" href="#student-list">Đi đến danh sách sinh viên</a>
  <div class="background-scene" aria-hidden="true">
    <div class="aurora aurora-one"></div><div class="aurora aurora-two"></div><div class="aurora aurora-three"></div>
    <div class="page-grid"></div>
  </div>
  <div class="cursor-light" aria-hidden="true"></div>

  <header class="site-header">
    <div class="header-inner page-shell">
      <a class="brand" href="/students" aria-label="Academia — trang chủ">
        <span class="brand-mark"><%- include('partials/icon', { name: 'graduation' }) %></span>
        <span class="brand-name">Academia<span>.</span><small>Không gian sinh viên</small></span>
      </a>
      <nav class="main-nav" aria-label="Điều hướng chính">
        <a href="#overview" class="overview-link">Tổng quan</a>
        <a href="#student-list">Danh sách</a>
        <a class="nav-add" href="#student-form"><%- include('partials/icon', { name: 'plus' }) %><span>Thêm sinh viên</span></a>
      </nav>
    </div>
  </header>

  <main class="page-shell">
    <section class="hero" id="overview" aria-labelledby="page-title">
      <div class="hero-depth" aria-hidden="true">
        <div class="hero-grid"></div><div class="hero-aura"></div><div class="hero-horizon"></div>
      </div>
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot" aria-hidden="true"></span>Nơi những kết nối bắt đầu</div>
        <h1 id="page-title"><span class="title-line"><span class="title-word">Danh bạ</span></span><span class="title-line"><span class="title-word gradient-text">sinh viên<span class="title-period">.</span></span></span></h1>
        <p class="hero-description">Mỗi hồ sơ là một kết nối.<br>Quản lý, tìm kiếm và mở rộng danh bạ của bạn — tất cả tại một nơi.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#student-list">Xem danh sách<%- include('partials/icon', { name: 'arrow' }) %></a>
          <a class="button button-secondary" href="#student-form"><%- include('partials/icon', { name: 'plus' }) %>Thêm sinh viên</a>
        </div>
        <div class="hero-caption"><span class="caption-line" aria-hidden="true"></span>Thông tin rõ ràng. Kết nối dễ dàng.</div>
      </div>

      <div class="orbit-parallax">
        <div class="hero-visual">
          <div class="orbit-stage" aria-hidden="true">
            <div class="orbit-halo"></div>
            <span class="orbit orbit-outer"></span><span class="orbit orbit-middle"></span><span class="orbit orbit-inner"></span>
            <span class="orbit-node node-one"></span><span class="orbit-node node-two"></span><span class="orbit-node node-three"></span>
            <span class="scan-line"></span>
            <div class="orbit-core"><span>Trong danh bạ</span><strong data-total><%= directoryUnavailable ? '—' : String(summary.total).padStart(2, '0') %></strong><small>sinh viên</small></div>
          </div>
          <div class="visual-chip chip-top" aria-hidden="true"><span class="chip-icon"><%- include('partials/icon', { name: 'users' }) %></span>Những kết nối mới</div>
          <div class="visual-chip chip-bottom" aria-hidden="true"><span class="chip-dot"></span>Từng hồ sơ, một dấu ấn</div>
          <span class="orbit-coordinate coordinate-top" aria-hidden="true">ACADEMIA / 01</span>
          <span class="orbit-coordinate coordinate-bottom" aria-hidden="true">HỒ SƠ · KẾT NỐI · TƯƠNG LAI</span>
        </div>
      </div>
      <a class="scroll-cue" href="#dashboard"><span>Khám phá danh bạ</span><%- include('partials/icon', { name: 'down' }) %></a>
    </section>

    <section class="dashboard" id="dashboard" aria-label="Tổng quan danh bạ">
      <div class="dashboard-intro" data-reveal><span class="section-kicker">Không gian của bạn</span><p>Một góc nhìn. Mọi hồ sơ.</p></div>
      <div class="stats-grid">
        <div class="stat-tile" data-reveal><div class="stat-surface stat-total">
          <div class="stat-heading"><span>Tổng sinh viên</span><span class="stat-icon"><%- include('partials/icon', { name: 'users' }) %></span></div>
          <strong class="stat-number" data-total><%= directoryUnavailable ? '—' : String(summary.total).padStart(2, '0') %></strong>
          <p>Những kết nối trong danh bạ</p>
        </div></div>
        <div class="stat-tile" data-reveal><div class="stat-surface">
          <div class="stat-heading"><span>Đã có MSSV</span><span class="stat-icon"><%- include('partials/icon', { name: 'id' }) %></span></div>
          <strong class="stat-number" data-with-id><%= directoryUnavailable ? '—' : String(summary.withStudentId).padStart(2, '0') %></strong>
          <p>Hồ sơ đã có mã số sinh viên</p>
        </div></div>
        <div class="stat-tile" data-reveal><div class="stat-surface">
          <div class="stat-heading"><span>Chưa có MSSV</span><span class="stat-icon stat-icon-pending"><%- include('partials/icon', { name: 'pending' }) %></span></div>
          <strong class="stat-number" data-missing-id><%= directoryUnavailable ? '—' : String(summary.missingStudentId).padStart(2, '0') %></strong>
          <p>Thông tin cần được bổ sung</p>
        </div></div>
      </div>

      <div class="workspace-grid">
        <section class="directory-panel surface" id="student-list" aria-labelledby="list-title">
          <div class="panel-heading">
            <div><span class="section-kicker">Danh bạ lớp học</span><h2 id="list-title">Những gương mặt<span class="heading-dot">.</span></h2></div>
            <span class="record-count" data-record-count><%= directoryUnavailable ? 'Chưa tải' : students.length + ' hồ sơ' %></span>
          </div>
          <div class="directory-tools" hidden>
            <div class="search-wrap"><%- include('partials/icon', { name: 'search' }) %><label class="sr-only" for="student-search">Tìm theo tên, MSSV hoặc email</label><input type="search" id="student-search" placeholder="Tìm tên, MSSV hoặc email…" autocomplete="off"></div>
            <div class="filter-group" role="group" aria-label="Lọc hồ sơ"><button type="button" class="filter-button is-active" data-filter="all" aria-pressed="true">Tất cả</button><button type="button" class="filter-button" data-filter="missing" aria-pressed="false">Chưa có MSSV<span data-filter-count><%= summary.missingStudentId %></span></button></div>
          </div>
          <%
            const createdStudent = students.find(student => student.id === createdStudentId);
          %>
          <div class="success-notice" id="success-notice" role="status" aria-live="polite"<%= createdStudent ? '' : ' hidden' %>><%- include('partials/icon', { name: 'check' }) %><p data-success-text><%= createdStudent ? 'Đã thêm ' + createdStudent.name + ' vào danh bạ.' : '' %></p></div>
          <% if (directoryUnavailable) { %>
            <div class="empty-state directory-unavailable" role="alert"><span class="empty-symbol"><%- include('partials/icon', { name: 'alert' }) %></span><h3>Danh bạ chưa sẵn sàng</h3><p><%= error %></p><a class="button button-secondary" href="/students"><%- include('partials/icon', { name: 'refresh' }) %>Tải lại danh bạ</a></div>
          <% } %>
          <div class="student-list" id="student-rows">
            <% students.forEach(student => { %><%- include('partials/student', { student, created: student.id === createdStudentId }) %><% }); %>
          </div>
          <div class="empty-state" id="directory-empty"<%= students.length || directoryUnavailable ? ' hidden' : '' %>><span class="empty-symbol"><%- include('partials/icon', { name: 'graduation' }) %></span><h3>Một danh bạ mới bắt đầu</h3><p>Thêm sinh viên đầu tiên để tạo kết nối đầu tiên.</p><a class="button button-secondary" href="#student-form"><%- include('partials/icon', { name: 'plus' }) %>Thêm sinh viên</a></div>
          <div class="empty-state" id="search-empty" hidden><span class="empty-symbol"><%- include('partials/icon', { name: 'search' }) %></span><h3>Chưa tìm thấy hồ sơ</h3><p>Thử tên khác hoặc xóa bộ lọc để xem toàn bộ danh bạ.</p><button class="button button-secondary" type="button" id="reset-search">Xóa tìm kiếm và bộ lọc</button></div>
          <p class="directory-footer" id="result-count" role="status" aria-live="polite"><%= directoryUnavailable ? 'Chưa tải được danh sách.' : 'Hiển thị ' + students.length + ' / ' + students.length + ' sinh viên' %></p>
        </section>

        <aside class="form-panel surface" id="student-form" aria-labelledby="form-title" data-reveal>
          <div class="form-emblem"><%- include('partials/icon', { name: 'plus' }) %></div>
          <span class="section-kicker">Thêm một kết nối</span><h2 id="form-title">Sinh viên mới</h2><p class="form-description">Một hồ sơ nhỏ.<br>Mở ra những kết nối lớn.</p>
          <div class="form-feedback" id="form-feedback" tabindex="-1" role="alert"<%= error && !errorField && !directoryUnavailable ? '' : ' hidden' %>><p data-feedback-text><%= error && !errorField ? error : '' %></p><a href="/students" data-feedback-reload hidden>Tải lại danh bạ để kiểm tra</a></div>
          <form method="POST" action="/students" class="student-form">
            <% const fields = [
              { key: 'studentId', label: 'Mã số sinh viên', type: 'text', placeholder: '24127203', icon: 'id', hint: 'Gồm 8 chữ số, không trùng mã đã có.', max: 8 },
              { key: 'name', label: 'Họ và tên', type: 'text', placeholder: 'Nguyễn Minh Anh', icon: 'user', hint: '', max: 100 },
              { key: 'email', label: 'Email', type: 'email', placeholder: 'sinhvien@example.com', icon: 'mail', hint: 'Sử dụng một địa chỉ email duy nhất.', max: 254 }
            ]; %>
            <% fields.forEach(field => { %>
              <div class="field-group">
                <label for="<%= field.key %>"><%= field.label %><span aria-hidden="true">*</span></label>
                <div class="input-wrap"><%- include('partials/icon', { name: field.icon }) %><input id="<%= field.key %>" name="<%= field.key %>" type="<%= field.type %>" placeholder="<%= field.placeholder %>" value="<%= formValues[field.key] %>" maxlength="<%= field.max %>"<% if (field.key === 'studentId') { %> inputmode="numeric" pattern="[0-9]{8}" autocomplete="off"<% } else if (field.key === 'name') { %> minlength="2" autocomplete="name"<% } else { %> autocomplete="email"<% } %> aria-describedby="<%= field.key %>-hint <%= field.key %>-error"<%= errorField === field.key ? ' aria-invalid=true' : '' %> required></div>
                <p class="field-hint" id="<%= field.key %>-hint"><%= field.hint %></p>
                <p class="field-error" id="<%= field.key %>-error" role="alert"<%= errorField === field.key ? '' : ' hidden' %>><%= errorField === field.key ? error : '' %></p>
              </div>
            <% }); %>
            <button class="button submit-button" type="submit"<%= directoryUnavailable ? ' disabled' : '' %>><span class="submit-symbol symbol-add"><%- include('partials/icon', { name: 'plus' }) %></span><span class="submit-symbol symbol-success"><%- include('partials/icon', { name: 'check' }) %></span><span class="submit-spinner" aria-hidden="true"></span><span data-submit-label>Thêm vào danh bạ</span><span class="submit-arrow"><%- include('partials/icon', { name: 'arrow' }) %></span></button>
            <p class="form-note"><%- include('partials/icon', { name: 'shield' }) %>MSSV và email được kiểm tra khi lưu.</p>
          </form>
        </aside>
      </div>
    </section>
  </main>
  <footer class="site-footer page-shell"><a class="footer-brand" href="#overview">Academia<span>.</span></a><p>Mỗi hồ sơ là một kết nối.</p><a href="#overview">Về đầu trang<%- include('partials/icon', { name: 'arrow' }) %></a></footer>
  <template id="student-card-template"><%- include('partials/student', { student: { id: '', name: '', studentId: '', email: '' }, created: false }) %></template>
</body>
</html>
