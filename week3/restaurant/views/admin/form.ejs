<%- include('../partials/header', { title }) %>
<div class="admin-content"><div class="breadcrumb"><a href="/admin/<%= resource %>"><%= config.plural %></a><span>/</span><span><%= record ? 'Sửa' : 'Thêm' %></span></div><div class="form-layout"><div><h1><%= title %></h1><p>Thông tin được kiểm tra ở server trước khi lưu vào database.</p></div>
  <form class="form-card" method="POST" action="<%= record ? '/admin/' + resource + '/' + record.id + '?_method=PATCH' : '/admin/' + resource %>" novalidate>
    <% if (Object.keys(errors).length) { %><div class="form-alert" role="alert">Vui lòng kiểm tra các trường được đánh dấu bên dưới.</div><% } %>
    <% config.fields.forEach((field) => { %><% if (field.type === 'checkbox') { %><label class="checkbox-row" for="field-<%= field.key %>"><input id="field-<%= field.key %>" name="<%= field.key %>" type="checkbox" <%= values[field.key] ? 'checked' : '' %>><span><strong><%= field.label %></strong><small>Bỏ chọn nếu món tạm hết.</small></span></label><% } else { %><div class="field"><label for="field-<%= field.key %>"><%= field.label %><%= field.required ? ' *' : '' %></label><% if (field.multiline) { %><textarea id="field-<%= field.key %>" name="<%= field.key %>" rows="4" maxlength="1000" <%- errors[field.key] ? 'aria-invalid="true" aria-describedby="error-' + field.key + '"' : '' %>><%= values[field.key] ?? '' %></textarea><% } else { %><input id="field-<%= field.key %>" name="<%= field.key %>" type="<%= field.type === 'number' ? 'number' : 'text' %>" value="<%= values[field.key] ?? '' %>" <%- field.type === 'number' ? 'min="0" step="1"' : 'maxlength="120"' %> <%- field.required ? 'required' : '' %> <%- errors[field.key] ? 'aria-invalid="true" aria-describedby="error-' + field.key + '"' : '' %>><% } %><% if (field.key === 'image') { %><small class="field-hint">Ví dụ: /beverages/matcha-latte.jpeg</small><% } %><% if (errors[field.key]) { %><p class="field-error" id="error-<%= field.key %>"><%= errors[field.key] %></p><% } %></div><% } %><% }) %>
    <div class="form-actions"><button class="button primary" type="submit"><%= record ? 'Lưu thay đổi' : 'Thêm mới' %></button><a class="button secondary" href="/admin/<%= resource %>">Hủy</a></div>
  </form></div>
</div>
<%- include('../partials/footer') %>
