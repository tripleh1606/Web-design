meta {
  name: GET /api/chefs/:id/dishes ok
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/chefs/{{seedChefId}}/dishes
  body: none
  auth: none
}

headers {
  Origin: {{corsOrigin}}
}

tests {
  const { expectOk } = require("./js/contract");
  test("chef dishes is array", function() {
    const body = expectOk(res, expect);
    expect(Array.isArray(body.data)).to.equal(true);
  });
}
