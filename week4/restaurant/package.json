{
  "name": "soucha-restaurant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "start:be": "node server.js",
    "start:fe": "node web/server.js",
    "dev": "node --watch server.js",
    "dev:be": "node --watch server.js",
    "dev:fe": "node web/server.js",
