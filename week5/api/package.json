  },
  "prisma": { "seed": "node prisma/seed.js" },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "dotenv": "16.6.1",
    "express": "4.21.2"
  },
  "devDependencies": { "prisma": "6.12.0" }
}
