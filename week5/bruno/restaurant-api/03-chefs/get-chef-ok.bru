meta {
  name: GET /api/chefs/:id ok
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/chefs/{{seedChefId}}
  body: none
  auth: none
}

headers {
  Origin: {{corsOrigin}}
}

tests {
  const { expectOk } = require("./js/contract");
  test("seed chef found", function() {
    const body = expectOk(res, expect);
    expect(body.data.id).to.equal(Number(bru.getEnvVar("seedChefId")));
  });
}
