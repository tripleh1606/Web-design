meta {
  name: Restaurant API
}

docs {
  Week 5 Soucha REST API (Web-design/week5).
  Base URL: http://localhost:3001
  Chạy API: npm start --workspace @soucha/api (hoặc npm run dev từ week5).
  Chạy collection: npm run test:bruno

  Business: HTTP 200 + { ok, data|error }
  Technical: 404/400/413/403/500 JSON { message }, không có ok
  CORS: Origin phải khớp SPA_ORIGIN; Origin lạ → 403
}
