{
  "name": "soucha-week5-rest-spa",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "test": "node --test --test-concurrency=2 tests/api.test.js tests/web.test.js tests/relations.test.js tests/database.test.js tests/beverages.test.js tests/pagination.test.js tests/chef-roster.test.js tests/search-setup.test.js tests/page-buffer.test.js tests/fulltext.test.js",
    "test:browser": "node tests/browser.js",
    "test:live": "node tests/live-smoke.js",
    "test:pagination:live": "node tests/live-pagination.js",
    "test:pagination:browser": "node tests/pagination-browser.js",
    "test:fulltext:browser": "node tests/fulltext-browser.js",
    "test:bruno": "cd bruno/restaurant-api && bru run -r --env local",
    "db:sql": "node scripts/export-sql.js",
    "db:search-setup": "node scripts/setup-search.js",
    "db:seed:beverages": "node scripts/seed-beverages.js",
    "db:seed:chefs": "node scripts/seed-chefs.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
