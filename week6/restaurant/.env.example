# Supabase Dashboard > Connect > Session pooler (port 5432).
# Replace the placeholder password locally. Keep this file free of real secrets.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
PORT=3001
APP_BASE_URL=http://localhost:3001
# Cookie name is sid. Session limits use positive integer minutes/hours.
SESSION_MAX_HOURS=24
SESSION_IDLE_MINUTES=30
# Existing millisecond aliases remain supported. If both names are supplied,
# their values must agree; otherwise startup fails with a configuration error.
# SESSION_TTL_MS=86400000
# SESSION_IDLE_MS=1800000
# Anonymous form-session lifetime is expressed in milliseconds.
ANONYMOUS_SESSION_TTL_MS=1800000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Google v2 Checkbox pair for register/login (not v3 or Cloud API keys).
# If BOTH values are absent/empty, auth uses the complete existing logout pair.
# If either auth value is set, supply BOTH; partial pairs do not fall back/mix.
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
# Google v2 Checkbox pair for logout; may also serve auth's fallback above.
LOGOUT_RECAPTCHA_V2_SITE_KEY=
LOGOUT_RECAPTCHA_V2_SECRET_KEY=
# Optional demo account. Never commit real values.
AUTH_SEED_EMAIL=
AUTH_SEED_PASSWORD=
# Disposable PostgreSQL tests: set explicitly in the shell, not the shared URL.
# AUTH_TEST_DATABASE_URL=postgresql://...
# AUTH_TEST_ALLOW_DB_WRITE=1
