# SQLite path is relative to prisma/schema.prisma: prisma/soucha.db.
# Keep credentials in your local .env only.
DATABASE_URL="file:./soucha.db"
PORT=3001
APP_BASE_URL=http://localhost:3001
SESSION_COOKIE_NAME=soucha_session
SESSION_TTL_HOURS=24
# Registration: durations are seconds; request windows are stated in each name.
ACTIVATION_OTP_TTL_SECONDS=600
ACTIVATION_MAX_ATTEMPTS=5
ACTIVATION_LOCK_SECONDS=900
ACTIVATION_RESEND_COOLDOWN_SECONDS=60
ACTIVATION_EMAIL_MAX_PER_HOUR=5
ACTIVATION_IP_MAX_PER_15_MINUTES=20
REGISTER_EMAIL_MAX_PER_15_MINUTES=5
REGISTER_IP_MAX_PER_15_MINUTES=20
ACTIVATE_EMAIL_MAX_PER_MINUTE=10
ACTIVATE_IP_MAX_PER_MINUTE=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# This implementation uses score-based v3 keys, not v2 checkbox or Cloud credentials.
RECAPTCHA_ADAPTER=v3
RECAPTCHA_MIN_SCORE=0.5
