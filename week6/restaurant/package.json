{
  "name": "soucha-restaurant-ssr",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "test:register": "node --test tests/auth-registration.test.js",
    "test:register:db": "node --test tests/auth-registration.db.js",
    "test:live": "node tests/live-smoke.js",
    "db:generate": "prisma generate",
    "db:push": "node scripts/prisma.js db push",
    "db:upgrade:register": "node scripts/prisma.js db execute --file prisma/registration-upgrade.sql --schema prisma/schema.prisma",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "argon2": "0.44.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "method-override": "^3.0.0",
    "nodemailer": "^10.3.1",
    "validator": "13.15.23"
  },
  "devDependencies": {
    "prisma": "6.12.0",
    "smtp-server": "3.21.3"
  },
  "engines": {
    "node": ">=20"
  }
}
