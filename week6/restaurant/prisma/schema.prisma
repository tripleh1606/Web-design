generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Int
  category    String?
  image       String?
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())

  ingredients DishIngredient[]
  chefs       ChefDish[]

  @@map("dishes")
}

model Chef {
  id        Int      @id @default(autoincrement())
  name      String
  specialty String
  createdAt DateTime @default(now())

  dishes ChefDish[]

  @@map("chefs")
}

model Ingredient {
  id        Int      @id @default(autoincrement())
  name      String
  unit      String
  stock     Int      @default(0)
  createdAt DateTime @default(now())

  dishes DishIngredient[]

  @@map("ingredients")
}

model DishIngredient {
  dishId       Int
  ingredientId Int
  amount       Int

  dish       Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([dishId, ingredientId])
  @@map("dish_ingredients")
}

model ChefDish {
  chefId Int
  dishId Int

  chef Chef @relation(fields: [chefId], references: [id], onDelete: Cascade)
  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@id([chefId, dishId])
  @@map("chef_dishes")
}

model User {
  id                 Int                      @id @default(autoincrement())
  email              String                   @unique
  passwordHash       String
  emailVerifiedAt    DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  passwordResets     PasswordReset[]
  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  csrfToken String
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model LoginAttempt {
  email       String   @id
  failures    Int      @default(0)
  lastFailure DateTime
  lockedUntil DateTime?
  @@map("login_attempts")
}

model LoginIpLimit {
  ip          String   @id
  count       Int
  windowStart DateTime
  @@map("login_ip_limits")
}

model PasswordReset {
  id            Int       @id @default(autoincrement())
  tokenHash     String    @unique
  userId        Int
  expiresAt     DateTime
  usedAt        DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model PasswordResetLimit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@map("password_reset_limits")
}
