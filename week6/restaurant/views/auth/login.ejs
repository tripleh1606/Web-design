<%- include('../partials/header', { title }) %>
<section class="admin-content"><h1>Đăng nhập</h1>
<% if (notice) { %><p class="form-notice" role="status"><%= notice %></p><% } %>
<% if (errors.form) { %><p class="form-alert" role="alert"><%= errors.form %></p><% } %>
<form method="POST" action="/login" class="form-card" data-captcha-action="login" data-captcha-site-key="<%= recaptchaSiteKey %>">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="next" value="<%= values.next %>">
<label>Email <input type="email" name="email" maxlength="254" value="<%= values.email %>" autocomplete="email" required></label>
<label>Mật khẩu <input type="password" name="password" maxlength="128" autocomplete="current-password" required></label>
<input type="hidden" name="g-recaptcha-response" value="">
<p data-captcha-error role="alert" hidden>Không thể xác minh CAPTCHA. Vui lòng tải lại trang và thử lại.</p><button type="submit">Đăng nhập</button>
</form>
<div style="margin-top: 1rem;">
  <a href="/register">Đăng ký</a> · <a href="/activate">Kích hoạt</a> · <a href="/auth/forgot">Quên mật khẩu?</a>
</div>
</section>
<%- include('captcha-script', { recaptchaSiteKey }) %>
<%- include('../partials/footer') %>
