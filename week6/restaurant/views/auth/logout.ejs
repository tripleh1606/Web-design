<%- include('../partials/header', { title }) %>
<div class="admin-content">
  <div class="form-layout">
    <div>
      <p class="danger-label">XÁC NHẬN THAO TÁC</p>
      <h1>Đăng xuất khỏi Soucha?</h1>
      <p>Bạn đang đăng nhập bằng <strong><%= email %></strong>.</p>
      <p>Phiên đăng nhập trên trình duyệt này sẽ kết thúc. Các thiết bị khác vẫn giữ phiên của mình.</p>
    </div>
    <section class="form-card" aria-label="Xác nhận đăng xuất">
      <% if (message) { %>
        <p class="form-alert" role="alert"><%= message %></p>
      <% } %>
      <form method="POST" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (captchaConfigured) { %>
          <div class="field">
            <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>" data-size="compact"></div>
          </div>
        <% } %>
        <div class="form-actions">
          <button class="button primary" type="submit" <% if (!captchaConfigured) { %>disabled<% } %>>Xác nhận đăng xuất</button>
          <a class="button secondary" href="/dishes">Tiếp tục sử dụng</a>
        </div>
      </form>
    </section>
  </div>
</div>
<% if (captchaConfigured) { %>
  <script src="https://www.google.com/recaptcha/api.js?hl=vi" async defer></script>
<% } %>
<%- include('../partials/footer') %>
