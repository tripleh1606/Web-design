<%- include('../partials/header', { title }) %>
<section class="admin-content"><h1>Đăng ký</h1>
<% Object.values(errors).forEach(error => { %><p class="form-alert" role="alert"><%= error %></p><% }) %>
<% if (error) { %><p class="auth-error-code" data-error-code="<%= error.code %>"><%= error.code %></p><% } %>
<form method="POST" action="/register" class="form-card" data-captcha-action="register" data-captcha-site-key="<%= recaptchaSiteKey %>">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Email <input type="email" name="email" maxlength="254" value="<%= values.email %>" autocomplete="email" required></label>
<label>Mật khẩu <input type="password" name="password" minlength="8" maxlength="128" autocomplete="new-password" required></label>
<label>Xác nhận mật khẩu <input type="password" name="confirmPassword" minlength="8" maxlength="128" autocomplete="new-password" required></label>
<input type="hidden" name="g-recaptcha-response" value="">
<p data-captcha-error role="alert" hidden>Không thể xác minh CAPTCHA. Vui lòng tải lại trang và thử lại.</p>
<button type="submit">Đăng ký</button>
</form><p>Đã có mã? <a href="/activate">Kích hoạt tài khoản</a>. Đã kích hoạt? <a href="/login">Đăng nhập</a>.</p></section>
<%- include('captcha-script', { recaptchaSiteKey }) %>
<%- include('../partials/footer') %>
