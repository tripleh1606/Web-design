generator client {
  provider = "prisma-client-js"
  output   = "../generated/postgresql"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Int
  category    String?
  image       String?
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  // Kept in sync by dishes_fts_refresh from search-setup.sql.
  fts         Unsupported("tsvector")?

  ingredients DishIngredient[]
  chefs       ChefDish[]

  @@index([fts], type: Gin, map: "dishes_fts_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "dishes_name_trgm_idx")
  @@index([category, available, price], map: "dishes_adv_filter_idx")
  @@map("dishes")
}

model Chef {
  id        Int      @id @default(autoincrement())
  name      String
  specialty String
  createdAt DateTime @default(now())

  dishes ChefDish[]

  @@map("chefs")
}

model Ingredient {
  id        Int      @id @default(autoincrement())
  name      String
  unit      String
  stock     Int      @default(0)
  createdAt DateTime @default(now())

  dishes DishIngredient[]

  @@map("ingredients")
}

model DishIngredient {
  dishId       Int
  ingredientId Int
  amount       Int

  dish       Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([dishId, ingredientId])
  @@map("dish_ingredients")
}

model ChefDish {
  chefId Int
  dishId Int

  chef Chef @relation(fields: [chefId], references: [id], onDelete: Cascade)
  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@id([chefId, dishId])
  @@map("chef_dishes")
}

enum AccountStatus {
  pending
  active
}

model User {
  id                 Int                      @id @default(autoincrement())
  email              String                   @unique
  emailOriginal      String                   @default("")
  role               String                   @default("viewer")
  status             AccountStatus            @default(pending)
  passwordHash       String
  emailVerifiedAt    DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  activationChallenge ActivationChallenge?
  passwordResets     PasswordReset[]
  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  sidHash   String   @unique @map("tokenHash")
  csrfToken String
  userId    Int?
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model LoginAttempt {
  emailKey    String   @id @map("email")
  failedCount Int      @default(0) @map("failures")
  windowStartedAt DateTime @default(now()) @map("lastFailure")
  lockedUntil DateTime?
  @@map("login_attempts")
}

model ActivationChallenge {
  userId      Int      @id
  purpose     String   @default("activation")
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  lockedUntil DateTime?
  lastSentAt  DateTime
  usedAt      DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("activation_challenges")
}

model ActivationAttempt {
  emailKey    String   @id
  attempts    Int      @default(0)
  lockedUntil DateTime?
  @@map("activation_attempts")
}

model RateLimitBucket {
  key             String   @id
  count           Int
  windowStartedAt DateTime
  nextAllowedAt   DateTime?
  @@map("rate_limit_buckets")
}

model LoginIpLimit {
  ip          String   @id
  count       Int
  windowStart DateTime
  @@map("login_ip_limits")
}

model PasswordReset {
  id            Int       @id @default(autoincrement())
  tokenHash     String    @unique
  userId        Int
  expiresAt     DateTime
  usedAt        DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model PasswordResetLimit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@map("password_reset_limits")
}
