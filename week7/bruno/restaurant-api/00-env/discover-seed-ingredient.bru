meta {
  name: Discover seed ingredient id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/ingredients
  body: none
  auth: none
}

headers {
  Origin: {{corsOrigin}}
}

script:post-response {
  const body = res.getBody();
  if (body.ok && Array.isArray(body.data)) {
    const matcha = body.data.find((i) => i.name === "Bột matcha");
    if (matcha) {
      bru.setEnvVar("seedIngredientId", String(matcha.id));
      bru.setEnvVar("ingredientId", String(matcha.id));
    } else if (body.data[0]) {
      bru.setEnvVar("seedIngredientId", String(body.data[0].id));
      bru.setEnvVar("ingredientId", String(body.data[0].id));
    }
  }
}

tests {
  const { expectOk } = require("./js/contract");
  test("list ingredients for seed discovery", function() {
    const body = expectOk(res, expect);
    expect(body.data.length).to.be.above(0);
  });
}
