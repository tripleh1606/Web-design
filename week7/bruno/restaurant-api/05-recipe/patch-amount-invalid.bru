meta {
  name: PATCH recipe amount invalid
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/dishes/{{seedDishId}}/ingredients/{{seedIngredientId}}
  body: json
  auth: none
}

headers {
  Origin: {{corsOrigin}}
  Content-Type: application/json
}

body:json {
  {
    "amount": 0
  }
}

tests {
  const { expectValidation } = require("./js/contract");
  test("invalid amount VALIDATION_FAILED", function() {
    expectValidation(res, expect, ["amount"]);
  });
}
