meta {
  name: Setup create test dish
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/dishes
  body: json
  auth: none
}

headers {
  Origin: {{corsOrigin}}
  Content-Type: application/json
}

script:pre-request {
  const stamp = bru.getVar("brunoStamp") || String(Date.now());
  req.setBody(JSON.stringify({
    name: `bruno-contract-dish-${stamp}`,
    description: "Bruno contract dish",
    price: 25000,
    category: "bruno",
    image: "/beverages/matcha-latte.jpeg",
    available: true
  }));
}

script:post-response {
  const body = res.getBody();
  if (body.ok && body.data?.id) {
    bru.setEnvVar("testDishId", String(body.data.id));
    bru.setEnvVar("dishId", String(body.data.id));
  }
}

tests {
  const { expectOk } = require("./js/contract");
  test("create test dish", function() {
    const body = expectOk(res, expect);
    expect(body.data.name).to.match(/^bruno-contract-dish-/);
  });
}
