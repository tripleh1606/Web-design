# Copy to week9/.env. Relative file: URLs resolve from api/prisma/.
DATABASE_URL=file:../../data/gallery.sqlite
HOST=127.0.0.1
PORT=5091
PUBLIC_ORIGIN=http://127.0.0.1:5091
# Optional web proxy: PUBLIC_ORIGIN=http://127.0.0.1:5090
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MANAGE_CAPABILITY=
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
CLEANUP_INTERVAL_SECONDS=60
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=gallery-photos
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
